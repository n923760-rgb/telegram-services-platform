# Copy to .env; never commit real credentials.
BOT_TOKEN=
ADMIN_IDS=[]
DATABASE_URL=postgresql+asyncpg://services:change-me@postgres:5432/services
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=services
POSTGRES_PASSWORD=change-me
POSTGRES_DB=services
APP_ENV=development
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Set current provider/model prices explicitly before enabling AI services.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
USD_TO_SAR=3.75
AI_ENABLED=false
AI_IMAGE_TOKEN_BOUND=20000
AI_MAX_OUTPUT_TOKENS=8192
MAX_DAILY_COST_SAR=50
MAX_COST_PER_USER_PER_DAY=10
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_JOB_COST_SAR=2
PROVIDER_LOW_BALANCE_SAR=10
FAILURE_ALERT_COUNT=3
CIRCUIT_WINDOW=10
CIRCUIT_MIN_SAMPLES=5
CIRCUIT_FAILURE_THRESHOLD=0.6
MAX_ATTEMPTS=3
REPORT_HOUR=23
REPORT_MINUTE=0
FILE_TTL_HOURS=24
MAX_FILE_BYTES=10485760
STORAGE_ROOT=/data/files
